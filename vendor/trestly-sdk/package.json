{
  "name": "trestly-sdk",
  "version": "0.1.0",
  "description": "TypeScript client library for routing x402 payments through Trestly escrow contract",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "escrow",
    "x402",
    "payment",
    "trestly"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/freighter-api": "^2.0.0",
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
